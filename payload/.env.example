# PostgreSQL connection string
DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/payload

# Minimum 32-character high-entropy secret for signing JWTs & cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# AES-256-GCM 32-byte hex key for Field-Level Data Encryption (PII: cardId, salary)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Redis rate limit store (optional, falls back to memory if empty)
REDIS_URL=redis://127.0.0.1:6379

# CORS & CSRF allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:9092,http://127.0.0.1:9092
