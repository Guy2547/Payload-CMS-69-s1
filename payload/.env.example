# PostgreSQL connection string
DATABASE_URL=postgres://payload:payload@127.0.0.1:5432/payload

# Minimum 32-character high-entropy secret for signing JWTs & cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# AES-256-GCM 32-byte hex key for Field-Level Data Encryption (PII: cardId, salary)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Redis rate limit store (optional, falls back to memory if empty)
REDIS_URL=redis://127.0.0.1:6379

# CORS & CSRF allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:9092,http://127.0.0.1:9092

# Email verification turns ON when EMAIL_SMTP_USER is set (needs USER+PASS to
# actually deliver; Users collection verify requires both). Sync from root .env.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Trust X-Forwarded-For/X-Real-IP for rate-limit keys ONLY behind a real reverse
# proxy (see TRUST_PROXY in env.simple). Leave empty for direct compose binding.
TRUST_PROXY=
