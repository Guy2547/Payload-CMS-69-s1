#1.ADMIN (collection: admins -> /api/admins/*)

##1.1 Signup (first admin ONLY - works while admins collection is empty)
POST http://localhost:9092/api/admins/first-register
content-type: application/json

{
  "email": "",
  "password": "",
  "firstname": "",
  "lastname": ""
}
###

##1.2 Login
# @name login
POST http://localhost:9092/api/admins/login
content-type: application/json

{
  "email": "",
  "password": ""
}
###

##1.3 adminForgot
# @name adminForgot
POST http://localhost:9092/api/admins/forgot-password
content-type: application/json

{
  "email": ""
}
###

##1.3.1 Reset password (token from admins.reset_password_token in DB, 40 chars)
POST http://localhost:9092/api/admins/reset-password
content-type: application/json

{
  "token": "PASTE_TOKEN_HERE",
  "password": ""
}
###

##1.4 Profile
GET http://localhost:9092/api/admins/me
Authorization: Bearer {{login.response.body.$.token}}
###

#2. User (collection: users -> /api/users/*)

##2.1 Signup (public register)
POST http://localhost:9092/api/users
content-type: application/json

{
  "email": "",
  "password": "",
  "username": ""
}
###

##2.2 Login
# @name userLogin
POST http://localhost:9092/api/users/login
content-type: application/json

{
  "email": "",
  "password": ""
}
###

##2.3 userForgot
# @name userForgot
POST http://localhost:9092/api/users/forgot-password
content-type: application/json

{
  "email": ""
}
###

##2.3.1 Reset password (token from users.reset_password_token in DB, 40 chars)
POST http://localhost:9092/api/users/reset-password
content-type: application/json

{
  "token": "PASTE_TOKEN_HERE",
  "password": ""
}
###

##2.4 Profile
GET http://localhost:9092/api/users/me
Authorization: Bearer {{userLogin.response.body.$.token}}
###

#3. Content (NOTE: Payload body is flat, NO {"data":...} wrapper; update = PATCH)

##3.1 Student

###3.1.1 Create Student
# @name createStudent
POST http://localhost:9092/api/students
content-type: application/json
Authorization: Bearer {{userLogin.response.body.$.token}}

{
  "name": "",
  "mobile": "",
  "cardId": ""
}
###

###3.1.2 List All Students
GET http://localhost:9092/api/students
Authorization: Bearer {{userLogin.response.body.$.token}}
###

###3.1.3 Get Student by ID
GET http://localhost:9092/api/students/{{createStudent.response.body.$.doc.id}}
Authorization: Bearer {{userLogin.response.body.$.token}}
###

###3.1.4 Update Student
PATCH http://localhost:9092/api/students/{{createStudent.response.body.$.doc.id}}
content-type: application/json
Authorization: Bearer {{userLogin.response.body.$.token}}

{
  "name": ""
}
###

###3.1.5 Delete Student
DELETE http://localhost:9092/api/students/{{createStudent.response.body.$.doc.id}}
Authorization: Bearer {{userLogin.response.body.$.token}}
###

