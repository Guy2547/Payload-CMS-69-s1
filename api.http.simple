#1.ADMIN (collection: admins -> /api/admins/*)

##1.1 Signup (first admin ONLY - works while admins collection is empty)
POST http://localhost:9092/api/admins/first-register
content-type: application/json

{
  "email": "",
  "password": "",
  "firstname": "",
  "lastname": ""
}
###

##1.2 Login
# @name login
POST http://localhost:9092/api/admins/login
content-type: application/json

{
  "email": "",
  "password": ""
}
###

##1.3 adminForgot
# @name adminForgot
POST http://localhost:9092/api/admins/forgot-password
content-type: application/json

{
  "email": ""
}
###

##1.3.1 Reset password (token from admins.reset_password_token in DB, 40 chars)
POST http://localhost:9092/api/admins/reset-password
content-type: application/json

{
  "token": "PASTE_TOKEN_HERE",
  "password": ""
}
###

##1.4 Profile
GET http://localhost:9092/api/admins/me
Authorization: Bearer {{login.response.body.$.token}}
###

#2. User (collection: users -> /api/users/*)

##2.1 Signup (public register)
POST http://localhost:9092/api/users
content-type: application/json

{
  "email": "",
  "password": "",
  "username": ""
}
###

##2.2 Login
# @name userLogin
POST http://localhost:9092/api/users/login
content-type: application/json

{
  "email": "",
  "password": ""
}
###

##2.3 userForgot
# @name userForgot
POST http://localhost:9092/api/users/forgot-password
content-type: application/json

{
  "email": ""
}
###

##2.3.1 Reset password (token from users.reset_password_token in DB, 40 chars)
POST http://localhost:9092/api/users/reset-password
content-type: application/json

{
  "token": "PASTE_TOKEN_HERE",
  "password": ""
}
###

##2.4 Profile
GET http://localhost:9092/api/users/me
Authorization: Bearer {{userLogin.response.body.$.token}}
###

#3. Content (NOTE: Payload body is flat, NO {"data":...} wrapper; update = PATCH)
# Strict: ADMIN token required for create/update/delete.

##3.1 Department

###3.1.1 Create Department
# @name createDepartment
POST http://localhost:9092/api/departments
content-type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{
  "name": "",
  "description": ""
}
###

###3.1.2 List All Departments
GET http://localhost:9092/api/departments
Authorization: Bearer {{login.response.body.$.token}}
###

###3.1.3 Get Department by ID
GET http://localhost:9092/api/departments/{{createDepartment.response.body.$.doc.id}}
Authorization: Bearer {{login.response.body.$.token}}
###

###3.1.4 Update Department
PATCH http://localhost:9092/api/departments/{{createDepartment.response.body.$.doc.id}}
content-type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{
  "description": ""
}
###

###3.1.5 Delete Department
DELETE http://localhost:9092/api/departments/{{createDepartment.response.body.$.doc.id}}
Authorization: Bearer {{login.response.body.$.token}}
###

##3.2 Position

###3.2.1 Create Position
# @name createPosition
POST http://localhost:9092/api/positions
content-type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{
  "name": "",
  "level": "junior",
  "description": ""
}
###

###3.2.2 List All Positions
GET http://localhost:9092/api/positions
Authorization: Bearer {{login.response.body.$.token}}
###

###3.2.3 Get Position by ID
GET http://localhost:9092/api/positions/{{createPosition.response.body.$.doc.id}}
Authorization: Bearer {{login.response.body.$.token}}
###

###3.2.4 Update Position
PATCH http://localhost:9092/api/positions/{{createPosition.response.body.$.doc.id}}
content-type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{
  "description": ""
}
###

###3.2.5 Delete Position
DELETE http://localhost:9092/api/positions/{{createPosition.response.body.$.doc.id}}
Authorization: Bearer {{login.response.body.$.token}}
###

##3.3 Employee

###3.3.1 Create Employee
# @name createEmployee
POST http://localhost:9092/api/employees
content-type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{
  "name": "",
  "mobile": "",
  "cardId": "",
  "department": "{{createDepartment.response.body.$.doc.id}}",
  "position": "{{createPosition.response.body.$.doc.id}}",
  "salary": 0
}
###

###3.3.2 List All Employees
GET http://localhost:9092/api/employees
Authorization: Bearer {{login.response.body.$.token}}
###

###3.3.3 Get Employee by ID
GET http://localhost:9092/api/employees/{{createEmployee.response.body.$.doc.id}}
Authorization: Bearer {{login.response.body.$.token}}
###

###3.3.4 Update Employee
PATCH http://localhost:9092/api/employees/{{createEmployee.response.body.$.doc.id}}
content-type: application/json
Authorization: Bearer {{login.response.body.$.token}}

{
  "name": ""
}
###

###3.3.5 Delete Employee
DELETE http://localhost:9092/api/employees/{{createEmployee.response.body.$.doc.id}}
Authorization: Bearer {{login.response.body.$.token}}
###
