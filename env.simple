DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
# Random 32-byte hex, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Field-Level Encryption (AES-256-GCM 32-byte hex key for PII / cardId & salary)
ENCRYPTION_KEY=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FORGOT_EMAIL=
DEMO_EMAIL=
DEMO_PASSWORD=
USER_FORGOT_EMAIL=
ADMIN_FIRSTNAME=
ADMIN_LASTNAME=
DEMO_USERNAME=
# --- RBAC seed accounts (api.http reads these via {{$dotenv ...}}; api.http.simple uses the same values hardcoded) ---
# Must match README section 3 + scripts/seed.mjs. Password must satisfy policy: min 12 chars + 3 of 4 classes.
RBAC_PASSWORD=SecPass12345!
RBAC_ADMIN_USER_EMAIL=admin_user@cybersec.local
RBAC_HR_EMAIL=hr_user@cybersec.local
RBAC_MANAGER_EMAIL=manager_user@cybersec.local
RBAC_EMPLOYEE_EMAIL=somchai.j@cybersec.local
RBAC_ATTACKER_EMAIL=attacker@cybersec.local
RBAC_ATTACKER_USERNAME=attacker
# --- Email (Gmail SMTP, fill in .env locally, never commit) ---
# Gmail needs an App Password (16 chars), NOT the normal password.
# Payload always uses nodemailer (no EMAIL_PROVIDER switch like Strapi).
# NOTE: passwords must satisfy the Strict policy (min 12 chars + 3 of 4 classes).
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=
# --- Security hardening (OWASP A01/A06) ---
# Public CORS/CSRF allowlist for the API (comma-separated). Defaults cover localhost.
CORS_ORIGINS=http://localhost:9092,http://127.0.0.1:9092
# Rate-limit store. Compose sets redis://redis:6379 in-container; for host dev
# (payload/.env) use redis://127.0.0.1:6379. Unset = in-memory fallback.
# Upstash-compatible: point at an Upstash Redis TLS endpoint instead.
REDIS_URL=
