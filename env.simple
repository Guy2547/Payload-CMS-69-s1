# ==============================================================================
# Environment Configuration Template - Payload CMS & Docker
# OWASP Compliant Example Template (Safe for GitHub / Version Control)
# CWE-798: No Hard-coded Credentials | OWASP Top 10:2025 A02 / A07 Hardened
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (which is gitignored).
# 2. Fill in the values for your local or production environment.
# 3. NEVER commit real secrets or credentials to GitHub.
# ==============================================================================

# --- Server Base URLs ---
BASE_URL=http://localhost:9092
PAYLOAD_URL=http://localhost:9092

# --- PostgreSQL Database Credentials (OWASP A07 / A02) ---
DATABASE_NAME=payload
DATABASE_USERNAME=payload
DATABASE_PASSWORD=

# --- Security Keys & Secrets (OWASP A02: Cryptographic Failures) ---
# High-entropy 32-byte (64 hex characters) secret for JWT & Session signing.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# AES-256-GCM 32-byte (64 hex characters) master key for Field-Level Encryption (PII: cardId, salary).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- pgAdmin Management Portal ---
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# --- Superadmin (Admins Collection) ---
# Password policy: Min 12 chars, upper/lower/digits/symbols
ADMIN_EMAIL=admin@cybersec.local
ADMIN_PASSWORD=
ADMIN_FIRSTNAME=Security
ADMIN_LASTNAME=Admin
ADMIN_FORGOT_EMAIL=admin@cybersec.local
ADMIN_NEW_PASSWORD=

# --- Standard User (Users Collection) ---
DEMO_EMAIL=demo@cybersec.local
DEMO_PASSWORD=
DEMO_USERNAME=demouser
USER_FORGOT_EMAIL=demo@cybersec.local
DEMO_NEW_PASSWORD=

# --- RBAC Seed Accounts (README section 3 + scripts/seed.mjs) ---
# Password policy: min 12 chars + 3 of 4 classes. Never commit real passwords.
RBAC_PASSWORD=
RBAC_TEST_PASSWORD=
RBAC_ADMIN_USER_EMAIL=admin_user@cybersec.local
RBAC_HR_EMAIL=hr_user@cybersec.local
RBAC_MANAGER_EMAIL=manager_user@cybersec.local
RBAC_EMPLOYEE_EMAIL=somchai.j@cybersec.local
RBAC_ATTACKER_EMAIL=attacker@cybersec.local
RBAC_ATTACKER_USERNAME=attacker

# --- Test Employee Mock Data (Field-Level Encryption verification) ---
TEST_EMPLOYEE_NAME=Nattapong CyberGuard
TEST_EMPLOYEE_EMAIL=nattapong.c@cybersec.local
TEST_EMPLOYEE_MOBILE=0891112233
TEST_EMPLOYEE_CARD_ID=1100400998877
TEST_EMPLOYEE_SALARY=75000

# --- Email SMTP (Gmail App Password, fill in locally, never commit) ---
# Gmail requires a 16-character App Password, NOT your regular account password.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=no-reply@localhost
EMAIL_REPLY_TO=

# --- Security Hardening & Rate Limiting (OWASP A01 / A04 / A06) ---
# Public CORS/CSRF allowlist for the API (comma-separated).
CORS_ORIGINS=http://localhost:9092,http://127.0.0.1:9092
# Redis Rate Limit store. In container: redis://redis:6379, host dev: redis://127.0.0.1:6379
REDIS_URL=redis://redis:6379
