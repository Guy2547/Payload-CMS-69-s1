# ==============================================================================
# Environment Configuration Template (Skeleton Only)
# OWASP Compliant: Zero Hardcoded Credentials (CWE-798 / A02 / A07)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (which is gitignored).
# 2. Fill in the values for your local or production environment.
# 3. NEVER commit real secrets, passwords, or credentials to GitHub.
# ==============================================================================

# --- Server Base URLs ---
# Used by scripts/seed.mjs (defaults to http://localhost:9092 when unset).
PAYLOAD_URL=

# --- PostgreSQL Database Credentials (OWASP A07 / A02) ---
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- Security Keys & Secrets (OWASP A02: Cryptographic Failures) ---
# High-entropy 32-byte (64 hex characters) secret for JWT & Session signing
PAYLOAD_SECRET=

# AES-256-GCM 32-byte (64 hex characters) master key for Field-Level Encryption (PII: cardId, salary)
ENCRYPTION_KEY=

# --- pgAdmin Management Portal ---
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# --- Superadmin (Admins Collection) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRSTNAME=
ADMIN_LASTNAME=
ADMIN_FORGOT_EMAIL=

# --- Standard User (Users Collection) ---
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_USERNAME=
USER_FORGOT_EMAIL=

# --- RBAC Seed Accounts (README section 3 + scripts/seed.mjs) ---
RBAC_PASSWORD=
RBAC_ADMIN_USER_EMAIL=
RBAC_HR_EMAIL=
RBAC_MANAGER_EMAIL=
RBAC_EMPLOYEE_EMAIL=
RBAC_ATTACKER_EMAIL=
RBAC_ATTACKER_USERNAME=

# --- Email SMTP ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Security Hardening & Rate Limiting (OWASP A01 / A04 / A06) ---
CORS_ORIGINS=
REDIS_URL=
# Trust X-Forwarded-For/X-Real-IP for rate-limit keys ONLY behind a real
# reverse proxy that sanitizes them. Leave empty (default) for direct
# docker-compose binding — otherwise anyone rotates the header for fresh buckets.
TRUST_PROXY=
