PORT=9092
DATABASE_NAME=payload
DATABASE_USERNAME=payload
DATABASE_PASSWORD=your_db_password_here
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=your_32_byte_hex_payload_secret_here
# OWASP A04: Field-Level Data Encryption Master Key (AES-256-GCM 32-byte hex key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_FIRSTNAME=Security
ADMIN_LASTNAME=Admin

DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=your_demo_password_here
DEMO_USERNAME=demouser

CORS_ORIGINS=http://localhost:9092,http://127.0.0.1:9092
REDIS_URL=redis://redis:6379
